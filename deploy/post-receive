#!/bin/sh
#
# Push-to-deploy. Install as the post-receive hook of a bare repo on the server:
#
#   git init --bare ~/untangle.git
#   cp deploy/post-receive ~/untangle.git/hooks/post-receive
#   chmod +x ~/untangle.git/hooks/post-receive
#
# and then, from a working clone:
#
#   git remote add prod <user>@<host>:untangle.git
#   git push prod main
#
# The build happens here rather than before the push, and inside the image rather than on
# the host — the Dockerfile is two-stage, so the ~35 packages it takes to build the UI never
# reach the thing that serves it. The host needs Docker and nothing else: no Node, no npm.
#
# The pool is deliberately not in the work tree. It lives in the `untangle-pool` volume that
# compose.yaml declares, so a checkout cannot reach it — which is the entire reason this is
# a git deploy and not an rsync. `checkout -f` leaves ignored and untracked files alone, but
# `rsync --delete` would take server/data/ with it, and that is everyone's stage times.

set -eu

APP=${UNTANGLE_APP:-$HOME/projects/apps/untangle}
REPO=${UNTANGLE_REPO:-$HOME/untangle.git}
BRANCH=${UNTANGLE_BRANCH:-main}

# post-receive is handed every ref that was pushed, on stdin. Without this loop a push of
# any branch — or a tag — would deploy whatever happens to be at BRANCH.
while read -r _old _new ref; do
  [ "$ref" = "refs/heads/$BRANCH" ] || continue

  echo "--> deploying $BRANCH to $APP"
  mkdir -p "$APP"
  git --work-tree="$APP" --git-dir="$REPO" checkout -f "$BRANCH"

  cd "$APP"
  docker compose up -d --build

  # Each rebuild leaves the previous image dangling, which over a few dozen deploys is a
  # full disk. Dangling only — this never touches a tagged image or the pool volume.
  docker image prune -f >/dev/null 2>&1 || true

  echo "--> up"
done
