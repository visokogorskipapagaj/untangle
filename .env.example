# PostHog. Copy to `.env` and fill in — `.env` is ignored, this file is tracked, and the
# split between them is the point: names and shapes live in git, values never do.
#
# The two halves of the integration take two different keys, and mixing them up is the one
# mistake here that matters. See src/analytics.ts and server/stats.js.
#
# Once filled in, `npm run stats` runs the three queries and reports what came back — which
# is the only way to tell a working setup from a broken one, since the server itself is
# built to fail silently rather than take the game down with it.


# --- the browser half: capturing -----------------------------------------------------------
#
# The *project* API key, from Settings -> Project -> General. It starts `phc_`, it can write
# events and read nothing, and it is meant to be public — Vite inlines anything named VITE_*
# into dist/, so this one ends up in every player's browser by design.
#
# Leave it unset and the game runs with analytics switched off, which is what a fresh
# checkout does.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# US or EU cloud, and it must match the region the key was issued in — a key used against
# the wrong host authenticates fine and then reports an empty project, which reads as "no
# traffic yet" rather than as the misconfiguration it is.
#   US: https://us.i.posthog.com   EU: https://eu.i.posthog.com
# Unset defaults to US (ANALYTICS.DEFAULT_INGEST_HOST in src/config.js).
VITE_POSTHOG_HOST=https://us.i.posthog.com


# --- the server half: reading the numbers back ---------------------------------------------
#
# These are read by server/index.js at runtime and are NOT prefixed VITE_, deliberately. The
# personal key below can read the entire project; naming it VITE_ANYTHING would compile it
# into the bundle and publish it to every player. Do not rename these.

# A *personal* API key, from Settings -> Personal API keys. It starts `phx_` and needs the
# "Performing analytics queries" (query:read) scope and nothing else.
POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The project id — the number in the dashboard URL, e.g. https://us.posthog.com/project/12345
POSTHOG_PROJECT_ID=12345

# Same region rule as above. Note this one has no `i.`: the query API is on the app host
# (us.posthog.com / eu.posthog.com), while the ingest host the browser posts events to is
# us.i.posthog.com. Both spellings work for ingest; only the app host answers queries.
POSTHOG_HOST=https://us.posthog.com
